{
  "name": "@netherite/root",
  "version": "0.0.0",
  "description": "Netherite app monorepo",
  "author": {
    "name": "vicentelyrio",
    "email": "vicentelyrio@gmail.com"
  },
  "repository": "https://github.com/vicentelyrio/netherite",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@1.22.19",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "postinstall": "manypkg check",
    "ci:lint": "turbo run lint",
    "ci:test": "turbo run test",
    "ci:format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "ci": "yarn ci:lint && yarn ci:format && yarn ci:test",
    "clean:deps": "manypkg exec rm -rf node_modules/ && rm -rf node_modules/",
    "clean:cache": "turbo run clean",
    "clean": "yarn clean:cache && yarn clean:deps",
    "dev": "turbo run dev --no-cache --continue",
    "build": "turbo run build",
    "deploy:changeset": "changeset",
    "deploy:version": "changeset version",
    "deploy:publish": "changeset publish",
    "deploy:release": "yarn deploy:build && yarn deploy:publish"
  },
  "dependencies": {
    "@changesets/cli": "^2.26.0",
    "@manypkg/cli": "^0.19.2",
    "@typescript-eslint/eslint-plugin": "^5.48.2",
    "@typescript-eslint/parser": "^5.48.2",
    "eslint": "^8.32.0",
    "eslint-config-netherite": "*",
    "eslint-plugin-import": "^2.27.5",
    "eslint-utils": "^3.0.0",
    "prettier": "^2.8.3",
    "turbo": "^1.7.0",
    "typescript": "^4.9.4"
  }
}
