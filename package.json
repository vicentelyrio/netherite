{
  "name": "@netherite/root",
  "version": "0.0.0",
  "description": "Netherite app monorepo",
  "author": {
    "name": "vicentelyrio",
    "email": "vicentelyrio@gmail.com"
  },
  "repository": "https://github.com/vicentelyrio/netherite",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@1.22.19",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "postinstall": "manypkg check",
    "dev": "turbo run dev --continue",
    "dev:services": "turbo run dev:standalone --continue --filter=./services/*",
    "dev:packages": "turbo run dev:standalone --continue --filter=./packages/*",
    "dev:core": "turbo run dev:standalone --continue --filter=!./apps/*",
    "build": "turbo run build",
    "build:services": "turbo run build --filter=@netherite/services",
    "build:core": "turbo run build --filter=!./apps/*",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo run test",
    "validate": "yarn lint && yarn format && yarn test",
    "repo:check": "manypkg check",
    "repo:fix": "manypkg fix",
    "clean:deps": "manypkg exec rm -rf node_modules/ && rm -rf node_modules/",
    "clean": "turbo run clean",
    "cs": "changeset",
    "cs:add": "changeset add",
    "cs:version": "changeset version",
    "cs:status": "changeset status",
    "cs:publish": "changeset publish",
    "cs:release": "yarn cs:version && yarn cs:publish"
  },
  "dependencies": {
    "@changesets/cli": "^2.26.0",
    "@manypkg/cli": "^0.19.2",
    "eslint-config-netherite": "*",
    "prettier": "^2.8.3",
    "turbo": "^1.8.5"
  }
}
