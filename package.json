{
  "name": "@netherite/root",
  "version": "0.0.0",
  "description": "Netherite app monorepo",
  "author": {
    "name": "vicentelyrio",
    "email": "vicentelyrio@gmail.com"
  },
  "repository": "https://github.com/vicentelyrio/netherite",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@1.22.19",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "postinstall": "manypkg check",
    "dev": "dotenv -- turbo run dev --continue --concurrency=100%",
    "dev:desktop": "dotenv -- turbo run dev --continue --filter=./services/graphql --filter=./packages/core --filter=./apps/desktop",
    "dev:web": "dotenv -- turbo run dev --continue --filter=./services/graphql --filter=./packages/core --filter=./apps/web",
    "build": "dotenv -- turbo run build",
    "typecheck": "dotenv -- turbo run typecheck",
    "lint": "dotenv -- turbo run lint",
    "lint:fix": "dotenv -- turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "dotenv -- turbo run test",
    "repo:check": "manypkg check",
    "repo:fix": "manypkg fix",
    "clean:deps": "manypkg exec rm -rf node_modules/ && rm -rf node_modules/",
    "clean": "turbo run clean",
    "cs": "changeset",
    "cs:add": "changeset add",
    "cs:version": "changeset version",
    "cs:status": "changeset status",
    "cs:publish": "changeset publish",
    "cs:release": "yarn cs:version && yarn cs:publish"
  },
  "dependencies": {
    "@changesets/cli": "^2.26.0",
    "@manypkg/cli": "^0.19.2",
    "dotenv-cli": "^7.2.1",
    "eslint-config-netherite": "*",
    "prettier": "^2.8.3",
    "turbo": "^1.8.5"
  }
}
