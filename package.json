{
  "name": "@netherite/root",
  "version": "0.0.0",
  "description": "Netherite: typed, linked knowledge for a git repository",
  "author": {
    "name": "vicentelyrio",
    "email": "vicentelyrio@gmail.com"
  },
  "repository": "https://github.com/vicentelyrio/netherite",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --continue",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "prepare": "lefthook install",
    "cs": "changeset",
    "cs:version": "changeset version",
    "cs:status": "changeset status",
    "cs:publish": "changeset publish",
    "test:scale": "turbo run test:scale",
    "e2e": "turbo run e2e",
    "docs:gen": "node scripts/gen-reference.mjs",
    "docs:check": "node scripts/gen-reference.mjs --check",
    "netherite:lint": "node packages/cli/dist/bin.mjs lint --fail-on warning",
    "netherite:context": "node packages/cli/dist/bin.mjs context sync --check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
