{
  "name": "@netherite/root",
  "version": "0.0.0-semantic-released",
  "description": "Netherite app monorepo",
  "author": "vicentelyrio <vicentelyrio@gmail.com>",
  "repository": "https://github.com/vicentelyrio/netherite",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "manypkg check",
    "build": "turbo run build",
    "dev": "turbo run dev --no-cache --continue",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=docs^... && changeset publish"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "dependencies": {
    "@changesets/cli": "^2.26.0",
    "@manypkg/cli": "^0.19.2",
    "eslint": "^8.32.0",
    "prettier": "^2.8.3",
    "turbo": "^1.7.0"
  }
}

