{
  "name": "@netherite/root",
  "version": "0.0.0",
  "description": "Netherite app monorepo",
  "author": {
    "name": "vicentelyrio",
    "email": "vicentelyrio@gmail.com"
  },
  "repository": "https://github.com/vicentelyrio/netherite",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@1.22.19",
  "workspaces": [
    "apps/*",
    "docs/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "postinstall": "manypkg check",
    "dev": "turbo run dev --no-cache --continue",
    "dev:dsbase": "yarn dev --filter=@netherite/ds-tokens --filter=@netherite/ds-components",
    "dev:ds": "yarn dev:dsbase --filter=@netherite/design-system",
    "dev:app": "yarn dev:dsbase --filter=@netherite/core --filter=@netherite/desktop",
    "dev:core": "turbo run dev:local --no-cache --continue --filter=@netherite/ds-tokens --filter=@netherite/ds-components --filter=@netherite/core",
    "dev:services": "turbo run dev:local --no-cache --continue --filter=@netherite/api",
    "build": "turbo run build --filter=!./docs/*",
    "build:docs": "turbo run build --filter=./docs/*",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo run test",
    "validate": "yarn lint && yarn format && yarn test",
    "repo:check": "manypkg check",
    "repo:fix": "manypkg fix",
    "clean:deps": "manypkg exec rm -rf node_modules/ && rm -rf node_modules/",
    "clean": "turbo run clean",
    "cs": "changeset",
    "cs:version": "changeset version",
    "cs:status": "changeset status",
    "cs:publish": "changeset publish",
    "release": "yarn build && yarn cs:publish"
  },
  "dependencies": {
    "@changesets/cli": "^2.26.0",
    "@manypkg/cli": "^0.19.2",
    "eslint-config-netherite": "*",
    "prettier": "^2.8.3",
    "turbo": "^1.8.3"
  }
}
