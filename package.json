{
  "name": "@netherite/root",
  "version": "0.0.0",
  "description": "Netherite: typed, linked knowledge for a git repository",
  "author": {
    "name": "vicentelyrio",
    "email": "vicentelyrio@gmail.com"
  },
  "repository": "https://github.com/vicentelyrio/netherite",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --continue",
    "dev:server": "node packages/cli/dist/bin.mjs serve --no-open --port 4747",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "prepare": "lefthook install",
    "cs": "changeset",
    "cs:version": "changeset version",
    "cs:status": "changeset status",
    "cs:publish": "changeset publish",
    "test:scale": "turbo run test:scale",
    "e2e": "turbo run e2e",
    "docs:gen": "node scripts/gen-reference.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:check": "node scripts/gen-reference.mjs --check && node scripts/check-npx-name.mjs",
    "netherite:lint": "node packages/cli/dist/bin.mjs lint --fail-on warning",
    "netherite:context": "node packages/cli/dist/bin.mjs context sync --check",
    "deps:check": "manypkg check",
    "deps:fix": "manypkg fix"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3",
    "@manypkg/cli": "^0.25.1",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vitepress": "^1.6.4",
    "vitest": "catalog:"
  },
  "manypkg": {
    "ignoredRules": [
      "INCORRECT_REPOSITORY_FIELD"
    ]
  }
}
