{
  "name": "@netherite/desktop",
  "productName": "Netherite",
  "version": "0.0.2",
  "description": "Netherite desktop app",
  "main": "./out/main/index.js",
  "private": true,
  "keywords": [],
  "repository": "https://github.com/vicentelyrio/netherite/tree/master/apps/desktop",
  "license": "MIT",
  "author": {
    "name": "vicentelyrio",
    "email": "vicentelyrio@gmail.com"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "TIMING=1 eslint --ext .ts,.tsx .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "yarn typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "yarn build && electron-builder --win --config",
    "build:mac": "electron-vite build && electron-builder --mac --config",
    "build:linux": "electron-vite build && electron-builder --linux --config",
    "clean:dist": "rm -rf build && rm -rf out",
    "clean:cache": "rm -rf .turbo",
    "clean": "yarn clean:dist && yarn clean:cache"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^1.0.3",
    "@electron-toolkit/utils": "^1.0.2",
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@netherite/api": "*",
    "@netherite/core": "*",
    "@netherite/ds-assets": "*",
    "@netherite/ds-components": "*",
    "@netherite/ds-tokens": "*",
    "apollo-bus-link": "^0.4.5",
    "electron-updater": "^5.3.0",
    "theme-ui": "^0.15.5"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/notarize": "^1.2.3",
    "@netherite/logger": "*",
    "@netherite/tsconfig": "*",
    "@types/node": "^18.11.18",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^5.57.0",
    "@typescript-eslint/parser": "^5.57.0",
    "@vitejs/plugin-react": "^3.1.0",
    "electron": "23.3.0",
    "electron-builder": "23.3.0",
    "electron-vite": "^1.0.21",
    "eslint": "^8.36.0",
    "eslint-config-netherite": "*",
    "eslint-plugin-react": "^7.32.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^4.9.4",
    "vite": "^4.2.1"
  }
}
