{
  "name": "@netherite/desktop",
  "productName": "Netherite",
  "version": "0.0.3",
  "description": "Netherite desktop app",
  "main": "./out/main/index.js",
  "private": true,
  "keywords": [],
  "repository": "https://github.com/vicentelyrio/netherite/tree/master/apps/desktop",
  "license": "MIT",
  "author": {
    "name": "vicentelyrio",
    "email": "vicentelyrio@gmail.com"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "TIMING=1 eslint --ext .ts,.tsx .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "yarn typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "yarn build && electron-builder --win --config",
    "build:mac": "electron-vite build && electron-builder --mac --config",
    "build:linux": "electron-vite build && electron-builder --linux --config",
    "clean:dist": "rm -rf dist && rm -rf out",
    "clean:cache": "rm -rf .turbo",
    "clean": "yarn clean:dist && yarn clean:cache"
  },
  "dependencies": {
    "@apollo/client": "^3.7.14",
    "@apollo/server": "^4.7.1",
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@graphql-tools/schema": "^9.0.19",
    "@netherite/core": "*",
    "@netherite/ds-assets": "*",
    "@netherite/ds-components": "*",
    "@netherite/ds-tokens": "*",
    "@netherite/service-fs": "*",
    "@netherite/service-graphql": "*",
    "apollo-bus-link": "^0.4.5",
    "class-validator": "^0.14.0",
    "electron-updater": "^5.3.0",
    "emotion-reset": "^3.0.1",
    "express": "^4.18.2",
    "graphql": "^16.6.0",
    "gray-matter": "^4.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reflect-metadata": "^0.1.13",
    "the-new-css-reset": "^1.8.4",
    "theme-ui": "^0.15.5",
    "type-graphql": "^2.0.0-beta.1",
    "typedi": "^0.10.0",
    "vite-express": "^0.6.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^1.0.3",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^1.0.2",
    "@electron/notarize": "^1.2.3",
    "@netherite/logger": "*",
    "@netherite/tsconfig": "*",
    "@types/node": "^18.11.18",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "23.3.0",
    "electron-builder": "23.3.0",
    "electron-vite": "^1.0.21",
    "eslint-config-netherite": "*",
    "typescript": "^4.9.4",
    "vite": "^4.2.1"
  }
}
