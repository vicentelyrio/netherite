{
  "display": "Desktop Server",
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@netherite/tsconfig/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./src/server",
    "outDir": "./dist/server",
    "target": "es5",
    "module": "esNext",
    "esModuleInterop": true
  },
  "include": ["src/server/*", "node_modules/@netherite/api"],
}

