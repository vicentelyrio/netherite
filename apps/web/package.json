{
  "name": "@netherite/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "repository": "https://github.com/vicentelyrio/netherite/tree/master/apps/web",
  "scripts": {
    "dev": "node src/server.js",
    "dev:standalone": "yarn dev",
    "build": "yarn clean:dist && tsc -b && vite build",
    "lint": "TIMING=1 eslint \"src/**/*.ts*\"",
    "preview": "vite preview",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "clean:dist": "rm -rf dist/",
    "clean:cache": "rm -rf .turbo",
    "clean": "yarn clean:dist && yarn clean:cache"
  },
  "dependencies": {
    "@apollo/client": "^3.7.14",
    "@apollo/server": "^4.7.4",
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@graphql-tools/schema": "^9.0.19",
    "@netherite/core": "*",
    "@netherite/ds-assets": "*",
    "@netherite/ds-components": "*",
    "@netherite/ds-tokens": "*",
    "@netherite/service-fs": "*",
    "@netherite/service-graphql": "*",
    "body-parser": "^1.20.2",
    "class-validator": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "graphql": "^16.6.0",
    "gray-matter": "^4.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reflect-metadata": "^0.1.13",
    "the-new-css-reset": "^1.8.4",
    "theme-ui": "^0.15.5",
    "type-graphql": "^2.0.0-beta.1",
    "typedi": "^0.10.0",
    "vite-express": "^0.6.0"
  },
  "devDependencies": {
    "@netherite/logger": "*",
    "@netherite/tsconfig": "*",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react-swc": "^3.3.0",
    "eslint-config-netherite": "*",
    "typescript": "^4.9.4",
    "vite": "^6.4.5"
  }
}
