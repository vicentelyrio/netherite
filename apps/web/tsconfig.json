{
  "display": "Web",
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@netherite/tsconfig/tsconfig.json",
  "references": [{ "path": "./tsconfig.node.json" }],
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "paths": {
      "*": ["./src/*"]
    },
    "preserveSymlinks": true,
    "types": ["vite/client"],
    "typeRoots": ["./src/@types", "./node_modules/@types"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/@types", "vite.config.ts"]
}

