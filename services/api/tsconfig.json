{
  "display": "Api",
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@netherite/tsconfig/tsconfig.json",
  "compilerOptions": {
    "lib": ["esnext", "esnext.asynciterable"],
    "module": "nodenext",
    "baseUrl": ".",
    "outDir": "./dist",
    "paths": {
      "*": ["src/*"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}

