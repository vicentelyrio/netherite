{
  "name": "@netherite/service-fs",
  "version": "0.0.1",
  "private": true,
  "repository": "https://github.com/vicentelyrio/netherite/tree/master/services/fs",
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "files": [
    "./dist/**"
  ],
  "scripts": {
    "build": "yarn clean:dist && tsc -b",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "dev": "tsc -b -w",
    "lint": "TIMING=1 eslint \"src/**/*.ts*\"",
    "clean:dist": "rm -rf dist/",
    "clean:cache": "rm -rf .turbo",
    "clean": "yarn clean:dist && yarn clean:cache"
  },
  "devDependencies": {
    "@netherite/tsconfig": "*",
    "@types/find-in-files": "^0.5.1",
    "@types/fs-extra": "^11.0.1",
    "@types/node": "^18.11.18",
    "eslint-config-netherite": "*",
    "gray-matter": "^4.0.3",
    "typedi": "^0.10.0",
    "typescript": "^4.9.4"
  },
  "peerDependencies": {
    "gray-matter": "^4.0.3",
    "typedi": "^0.10.0"
  }
}
