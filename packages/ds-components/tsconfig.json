{
  "display": "DS-Components",
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@netherite/tsconfig/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "lib": ["dom", "dom.iterable", "esnext"],
    "baseUrl": ".",
    "paths": {
      "*": ["./src/*"]
    },
    "outDir": "./dist"
  },
  "include": ["src/**/*", "types/**/*"],
  "exclude": ["node_modules"]
}
