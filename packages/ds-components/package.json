{
  "name": "@netherite/ds-components",
  "version": "0.0.3",
  "private": true,
  "repository": "https://github.com/vicentelyrio/netherite/tree/master/packages/ds-components",
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/**"
  ],
  "scripts": {
    "build": "yarn clean:dist && tsc -b && tsc-alias",
    "dev:watch": "tsc -b -w",
    "dev:alias": "tsc-alias -w",
    "dev": "concurrently \"npm:dev:watch\" \"npm:dev:alias\"",
    "dev:local": "yarn dev",
    "lint": "TIMING=1 eslint \"src/**/*.ts*\"",
    "clean:dist": "rm -rf dist/",
    "clean:cache": "rm -rf .turbo",
    "clean": "yarn clean:dist && yarn clean:cache"
  },
  "devDependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@netherite/ds-assets": "*",
    "@netherite/ds-tokens": "*",
    "@netherite/tsconfig": "*",
    "@types/react": "^18.0.27",
    "concurrently": "^7.6.0",
    "eslint-config-netherite": "*",
    "react": "^18.2.0",
    "rollup": "^3.17.3",
    "rollup-plugin-dts": "^5.2.0",
    "rollup-plugin-esbuild": "^5.0.0",
    "theme-ui": "^0.15.5",
    "tsc-alias": "^1.8.4",
    "typescript": "^4.9.4"
  },
  "peerDependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@netherite/ds-tokens": "*",
    "react": "^18.2.0",
    "theme-ui": "^0.15.5"
  }
}
