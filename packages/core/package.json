{
  "name": "@netherite/core",
  "version": "0.0.6",
  "private": true,
  "repository": "https://github.com/vicentelyrio/netherite/tree/master/packages/core",
  "type": "module",
  "main": "./dist/App.umd.cjs",
  "module": "./dist/App.js",
  "typings": "./dist/App.d.ts",
  "files": [
    "./dist/**"
  ],
  "exports": {
    ".": {
      "import": "./dist/App.js",
      "require": [
        "./dist/App.umd.cjs",
        "./dist/App.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "yarn clean:dist && tsc -b && vite build",
    "dev": "tsc -b && vite build -w",
    "dev:standalone": "yarn dev",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "TIMING=1 eslint \"src/**/*.ts*\"",
    "clean:dist": "rm -rf dist/",
    "clean:cache": "rm -rf .turbo",
    "clean": "yarn clean:dist && yarn clean:cache"
  },
  "devDependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@netherite/ds-assets": "*",
    "@netherite/ds-components": "*",
    "@netherite/ds-tokens": "*",
    "@netherite/service-graphql": "*",
    "@netherite/tsconfig": "*",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react-swc": "^3.3.0",
    "eslint-config-netherite": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "theme-ui": "^0.15.5",
    "typescript": "^4.9.4",
    "vite": "^6.4.5",
    "vite-plugin-dts": "^1.7.1",
    "vite-tsconfig-paths": "^4.0.5"
  },
  "dependencies": {
    "@tanstack/react-location": "^3.7.4",
    "rehype-stringify": "^9.0.3",
    "remark-frontmatter": "^4.0.1",
    "remark-parse": "^10.0.1",
    "remark-parse-frontmatter": "^1.0.3",
    "remark-rehype": "^10.1.0",
    "remark-stringify": "^10.0.2",
    "the-new-css-reset": "^1.8.4",
    "unified": "^10.1.2"
  },
  "peerDependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@netherite/ds-assets": "*",
    "@netherite/ds-components": "*",
    "@netherite/ds-tokens": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "theme-ui": "^0.15.5"
  }
}
