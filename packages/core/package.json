{
  "name": "@netherite/core",
  "version": "0.0.2",
  "private": true,
  "repository": "https://github.com/vicentelyrio/netherite/tree/master/packages/core",
  "type": "module",
  "main": "./dist/App.umd.cjs",
  "module": "./dist/App.js",
  "typings": "./dist/App.d.ts",
  "exports": {
    ".": {
      "import": "./dist/App.js",
      "require": [
        "./dist/App.umd.cjs",
        "./dist/App.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "yarn clean:dist && tsc -b && vite build",
    "dev": "tsc -b && vite build -w",
    "dev:local": "vite dev",
    "preview": "vite preview",
    "lint": "TIMING=1 eslint \"src/**/*.ts*\"",
    "clean:dist": "rm -rf dist/",
    "clean:cache": "rm -rf .turbo",
    "clean": "yarn clean:dist && yarn clean:cache"
  },
  "devDependencies": {
    "@netherite/tsconfig": "*",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@vitejs/plugin-react-swc": "^3.0.0",
    "eslint-config-netherite": "*",
    "typescript": "^4.9.4",
    "vite": "^4.0.0",
    "vite-plugin-dts": "^1.7.1"
  },
  "dependencies": {
    "@apollo/client": "^3.7.7",
    "@netherite/ds-components": "*",
    "graphql": "^16.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite-tsconfig-paths": "^4.0.5"
  }
}
