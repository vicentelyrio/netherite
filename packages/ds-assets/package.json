{
  "name": "@netherite/ds-assets",
  "version": "0.0.0",
  "private": true,
  "repository": "https://github.com/vicentelyrio/netherite/tree/master/packages/ds-assets",
  "main": "./dist/index.ts",
  "types": "./dist/build/index.ts",
  "files": [
    "./dist/**"
  ],
  "scripts": {
    "build:icons": "svgr -- src/assets/**/*.svg",
    "build:lib": "svg-to-ts-files",
    "build": "yarn clean:dist && yarn build:lib",
    "dev": "yarn build",
    "dev:local": "yarn build",
    "lint": "TIMING=1 eslint \"src/**/*.ts*\"",
    "clean:dist": "rm -rf dist/",
    "clean:cache": "rm -rf .turbo",
    "clean": "yarn clean:dist && yarn clean:cache"
  },
  "devDependencies": {
    "@netherite/tsconfig": "*",
    "eslint-config-netherite": "*",
    "svg-to-ts": "^10.0.0",
    "typescript": "^4.9.4"
  }
}
