{
  "name": "@netherite/ds-assets",
  "version": "0.0.1",
  "private": true,
  "repository": "https://github.com/vicentelyrio/netherite/tree/master/packages/ds-assets",
  "source": "./generated/index.js",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "./dist/**"
  ],
  "scripts": {
    "build:icons": "svg-to-ts-files",
    "build:ts": "tsc -b",
    "build": "yarn clean:dist && yarn build:icons && yarn build:ts",
    "dev": "yarn build",
    "dev:local": "yarn build",
    "lint": "TIMING=1 eslint \"generated/**/*.ts*\"",
    "clean:dist": "rm -rf dist/ && rm -rf generated/",
    "clean:cache": "rm -rf .turbo",
    "clean": "yarn clean:dist && yarn clean:cache"
  },
  "devDependencies": {
    "@netherite/tsconfig": "*",
    "eslint-config-netherite": "*",
    "svg-to-ts": "^10.0.0",
    "typescript": "^4.9.4"
  }
}
