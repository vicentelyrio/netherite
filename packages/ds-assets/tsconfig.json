{
  "display": "DS-Assets",
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@netherite/tsconfig/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "noImplicitAny": false,
    "jsx": "react-jsx",
    "typeRoots": ["./src/@types", "./node_modules/@types"]
  },
  "include": ["src/**/*", "generated/**/*"],
  "exclude": ["node_modules"]
}
