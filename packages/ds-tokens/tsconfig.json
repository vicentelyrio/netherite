{
  "display": "DS-Tokens",
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@netherite/tsconfig/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "*": ["./src/*"],
      "@netherite/ds-tokens/*": [
        "./dist/*"
      ]
    },
    "outDir": "./dist",
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

