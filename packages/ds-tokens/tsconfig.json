{
  "display": "DS-Tokens",
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@netherite/tsconfig/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "*": ["./src/*"]
    },
    "rootDirs": ["./src/*", "./types/*"]
  },
  "include": ["src/**/*", "types/**/*"],
  "exclude": ["node_modules"]
}

