{
  "name": "@netherite/ds-tokens",
  "version": "0.0.3",
  "private": true,
  "repository": "https://github.com/vicentelyrio/netherite/tree/master/packages/ds-tokens",
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/**"
  ],
  "scripts": {
    "build": "yarn clean:dist && tsc -b",
    "dev": "tsc -b -w",
    "dev:standalone": "yarn dev",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "TIMING=1 eslint \"src/**/*.ts*\"",
    "clean:dist": "rm -rf dist/",
    "clean:cache": "rm -rf .turbo",
    "clean": "yarn clean:dist && yarn clean:cache"
  },
  "devDependencies": {
    "@netherite/tsconfig": "*",
    "eslint-config-netherite": "*",
    "theme-ui": "^0.15.5",
    "typescript": "^4.9.4"
  },
  "peerDependencies": {
    "theme-ui": "^0.15.5"
  }
}
