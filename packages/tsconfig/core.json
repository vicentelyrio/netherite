{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Core",
  "extends": "./base.json",
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": false,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "esnext",
    "outDir": "dist",
    "resolveJsonModule": true,
    "target": "esnext",
    "useDefineForClassFields": true
  },
  "exclude": ["node_modules"]
}

