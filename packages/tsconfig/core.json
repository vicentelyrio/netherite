{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Core",
  "extends": "./base.json",
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "target": "esnext",
    "resolveJsonModule": true,
    "emitDeclarationOnly": false,
    "useDefineForClassFields": true
  }
}
